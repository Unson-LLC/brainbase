{
  "name": "mcp-brainbase",
  "version": "1.0.0",
  "description": "MCP Server for brainbase _codex entity context",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:graph-maintenance": "tsx --test tests/tools/graph-maintenance-tools.test.ts --test-name-pattern='Graph maintenance MCP tools'"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true
  }
}
