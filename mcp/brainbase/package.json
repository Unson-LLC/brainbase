{
  "name": "mcp-brainbase",
  "version": "1.0.0",
  "description": "MCP Server for brainbase _codex entity context",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:graph-maintenance": "tsx --test tests/tools/graph-maintenance-tools.test.ts --test-name-pattern='Graph maintenance MCP tools'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
