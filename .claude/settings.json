{
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "refreshInterval": 30
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/pre-tool-use/forbidden-commands-wrapper.ts \\\"$CLAUDE_TOOL_INPUT\\\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/post-tool-use/activity-bridge.ts \\\"$CLAUDE_TOOL_INPUT\\\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/user-prompt-submit/ssot-self-assessment.ts",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/user-prompt-submit/activity-bridge.ts",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "^(/test\\b|npm (run )?test\\b|pytest\\b|vitest\\b|playwright test\\b)|テストを?(実行|走らせ|流し|回し)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/user-prompt-submit/test-enforcer.ts",
            "timeout": 120000
          }
        ]
      },
      {
        "matcher": "(マージして|mergeして|merge\\b|/merge\\b)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/user-prompt-submit/merge-api-reminder.ts",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/stop/jj-commit-guard.ts",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/stop/activity-bridge.ts",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start-copy-plugins.sh"
          }
        ]
      }
    ]
  }
}
