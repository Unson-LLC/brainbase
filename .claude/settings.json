{
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "refreshInterval": 30
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/pre-tool-use/forbidden-commands-wrapper.ts \\\"$CLAUDE_TOOL_INPUT\\\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "^(/test\\b|npm (run )?test\\b|pytest\\b|vitest\\b|playwright test\\b)|テストを?(実行|走らせ|流し|回し)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/user-prompt-submit/test-enforcer.ts",
            "timeout": 120000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/stop/git-commit-guard.ts",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start-copy-plugins.sh"
          },
          {
            "type": "command",
            "command": ".claude/scripts/run-hook.sh .claude/scripts/hooks/session-start/inject-memory-preamble.ts",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
