{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codex-hooks-activity.sh",
            "statusMessage": "brainbase activity"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codex-hooks-activity.sh",
            "statusMessage": "brainbase activity"
          },
          {
            "type": "command",
            "command": "bash scripts/codex-capability-map-reminder.sh",
            "statusMessage": "brainbase capability map reminder"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codex-hooks-activity.sh",
            "statusMessage": "brainbase activity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codex-hooks-activity.sh",
            "statusMessage": "brainbase activity"
          }
        ]
      }
    ]
  }
}
