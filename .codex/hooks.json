{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codex-hooks/inject-memory-preamble.sh",
            "statusMessage": "brainbase memory preamble"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codex-hooks-pre-tool-use-protected-push.sh",
            "statusMessage": "brainbase protected-push guard"
          }
        ]
      }
    ]
  }
}
