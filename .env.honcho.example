# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Honcho Memory Server - Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# cp .env.honcho.example .env.honcho
# 値を設定してから docker compose up

# PostgreSQL パスワード
HONCHO_DB_PASSWORD=changeme_honcho_password

# LLM プロバイダー設定（Deriver用）
# OpenRouter経由でGemini Flash等を使用
OPENROUTER_API_KEY=
# または直接Anthropic/OpenAI
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Honcho API設定
# USE_AUTH=false  # 認証を無効化（内部ネットワークのみの場合）

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# brainbase側の設定（.envに追加）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HONCHO_API_URL=http://127.0.0.1:8000
# HONCHO_WORKSPACE_ID=brainbase
