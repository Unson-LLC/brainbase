# 雲孫の組織版Web本番設定。秘密値は含めず、Infisicalから別ファイルへ配備する。
ORGANIZATION_WEB_HOST=bb-app.unson.jp
ORGANIZATION_ID=unson
ORGANIZATION_DISPLAY_NAME=雲孫
ORGANIZATION_DIRECTORY_JSON=[{"organization_id":"unson","display_name":"雲孫","app_origin":"https://bb-app.unson.jp"}]
BRAINBASE_API_URL=https://bb.unson.jp
PROXY_NETWORK=ubuntu_nocodb-network
BRAINBASE_SERVICE_TOKEN_FILE_HOST=/etc/brainbase-organization/brainbase-service-token
