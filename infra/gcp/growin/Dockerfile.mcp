FROM node:20-bookworm-slim AS build

WORKDIR /app/mcp/brainbase
COPY mcp/brainbase/package.json mcp/brainbase/package-lock.json ./
RUN npm ci
COPY mcp/brainbase/tsconfig.json ./
COPY mcp/brainbase/src ./src
RUN npm run build

FROM node:20-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app/mcp/brainbase

COPY mcp/brainbase/package.json mcp/brainbase/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/mcp/brainbase/dist ./dist

USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
