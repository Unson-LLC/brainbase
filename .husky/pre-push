#!/usr/bin/env bash
# Canonical VibePro runtimeを検証し、そのruntimeのPR preparationだけをpush判断に使う。

set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CONTRACT="$ROOT/.claude/scripts/hooks/lib/vibepro-runtime-contract.mjs"
if ! IDENTITY=$(node "$CONTRACT" identity --cwd "$ROOT"); then
  echo "❌ [husky/pre-push] canonical VibePro runtime identityを検証できません" >&2
  exit 1
fi

SUMMARY=$(node -e '
let buf=""; process.stdin.on("data", d => buf += d); process.stdin.on("end", () => {
  const x=JSON.parse(buf).runtime_identity;
  process.stdout.write(`${x.package.exact_version} source=${x.source_git.commit} identity=${x.identity_digest}`);
});' <<< "$IDENTITY")
echo "[husky/pre-push] VibePro $SUMMARY"

if [ "${BRAINBASE_ALLOW_PUSH_WITHOUT_GATE:-0}" = "1" ]; then
  echo "[husky/pre-push] PR preparation skipped (BRAINBASE_ALLOW_PUSH_WITHOUT_GATE=1; runtime identity verified)"
  exit 0
fi

BRANCH=$(git branch --show-current 2>/dev/null || echo "")
case "$BRANCH" in
  session/*) ;;
  *)
    echo "[husky/pre-push] Skip gate check (branch=$BRANCH)"
    exit 0
    ;;
esac

if OUTPUT=$(node "$CONTRACT" pr-prepare --cwd "$ROOT" --base origin/develop); then
  PREPARED_DIGEST=$(node -e '
let buf=""; process.stdin.on("data", d => buf += d); process.stdin.on("end", () => {
  process.stdout.write(JSON.parse(buf).runtime_identity.identity_digest);
});' <<< "$OUTPUT")
  echo "[husky/pre-push] pr prepare runtime identity=$PREPARED_DIGEST ✓"
  exit 0
fi

echo "❌ [husky/pre-push] canonical runtimeでpr prepareを完了できませんでした" >&2
echo "対処:"
echo "  1. canonical VibeProで必要な検証証跡を再生成する"
echo "  2. vibepro pr prepare . --base origin/develop を再実行する"
echo "緊急時の escape:"
echo "  BRAINBASE_ALLOW_PUSH_WITHOUT_GATE=1 git push ..."
echo "  (runtime identity検証は省略されません。PR本文にbypass理由を残してください)"
exit 1
