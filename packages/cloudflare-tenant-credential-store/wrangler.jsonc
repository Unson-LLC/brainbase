{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainbase-tenant-credential-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_CREDENTIAL_STORE",
        "class_name": "TenantCredentialStoreDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenantCredentialStoreDurableObject"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
