{
  "schemaVersion": "1.0.0",
  "package": {
    "name": "@unson/brainbase-mcp",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
      "brainbase-mcp": "dist/index.js",
      "brainbase": "dist/cli.js"
    }
  },
  "mcpTools": [
    { "name": "get_context", "requiredInput": [] },
    { "name": "list_entities", "requiredInput": [] },
