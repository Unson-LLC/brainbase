    "onboard:recommend",
    "onboard:diagnose-sources",
    "onboard:plan",
    "onboard:projects",
    "onboard:candidates",
    "onboard:import",
    "onboard:extract",
    "onboard:apply",
    "onboard:routines",
    "onboard:skills",
    "ontology:show",
    "ontology:audit",
    "ontology:migrate",
    "judgment:hook",
    "judgment:install",
    "doctor",
    "mcp"
  ]
