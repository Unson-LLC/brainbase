    "signing_input": "ASCII(protected64 + '.') || UTF-8(JCS(unsigned payload without integrity))",
    "maximum_ttl_seconds": 300,
    "maximum_clock_skew_seconds": 30,
    "issuer": "brainbase",
    "audience": ["mana-runtime"],
    "nested_tenant_context": {
