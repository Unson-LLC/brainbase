            },
            "required_evidence": [
                "current_head_verification"
            ],
            "unknown_policy": "The meeting_note_generation handoff context may only be built from the referenced run's meeting_note_draft output within the loop intent's own org/project scope, and must never include server-owned secrets such as continuation_token. Referenced dispatches without a resolvable transcript source (missing output or source_text_hash) must be rejected before any Eve session is created. Ingest-triggered auto-dispatch stays best-effort: context resolution failures are recorded as skipped dispatches without failing Review Package ingest. The write-back contract description in the handoff is derived from recordNoteGeneration and must not introduce a new write path."
        }
    ]
