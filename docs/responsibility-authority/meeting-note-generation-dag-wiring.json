{
    "schema_version": "0.1.0",
    "story_id": "story-meeting-note-generation-dag-wiring",
    "title": "Meeting Note Generation DAG Wiring Authority",
    "responsibilities": [
        {
            "id": "meeting_note_generation_writeback_and_dispatch",
            "primary_authority": {
                "kind": "architecture",
                "ref": "docs/architecture/meeting-note-generation-dag-wiring-architecture.md#boundary"
            },
            "supporting_authority": [
                {
                    "kind": "spec",
                    "ref": "docs/specs/story-meeting-note-generation-dag-wiring-spec.md#note-generation-write-back-contract"
                }
            ],
            "owned_surfaces": {
                "paths": [
                    "server/routes/workflows.js",
                    "server/services/automation-runtime/eve-session-dispatch-service.js",
                    "server/services/workflow/workflow-repository.js",
                    "server/services/meeting-automation/meeting-automation-service.js",
                    "server/services/meeting-automation/meeting-review-ledger-service.js",
                    "server/services/meeting-source/meeting-source-mcp-sync-service.js"
                ],
                "symbols": [
                    "MeetingAutomationService.recordNoteGeneration",
                    "MeetingAutomationService.dispatchNoteGeneration",
                    "InMemoryWorkflowRepository.updateOutput",
                    "transcriptSegmentsToText",
                    "note_generation_dispatch",
                    "brainbase_generated"
                ],
                "risk_surfaces": [
                    "core_workflow_state"
                ]
            },
            "required_evidence": [
                "current_head_verification"
            ],
            "unknown_policy": "meeting_note_draft output body may transition to brainbase_generated only through the note-generation write-back contract with a matching source_text_hash, run scope, and non-empty generated body. Auto-dispatch to Eve is best-effort: any unconfigured or failed dispatch must be recorded as skipped without failing Review Package ingest, and provider-generated notes must never be promoted into the Brainbase minutes body."
        }
    ]
}
