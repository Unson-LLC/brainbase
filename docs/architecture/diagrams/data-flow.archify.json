  "meta": {
    "title": "Brainbase Organization Signal → Judgment → Action → Learning Flow",
    "output": "generated/data-flow.html",
    "quality_profile": "showcase",
    "viewBox": [
      1180,
      940
    ],
    "views": [
      {
        "id": "bind",
        "label": "入力を会社文脈へ束縛",
        "focus": [
          "human-request",
          "org-signals",
          "system-facts",
          "secure-ingress",
          "tenant-binding"
        ],
        "note": "外部入力はtenantや権限を主張できても決定できない。認証済みidentityとresourceをBrainbaseが正本へ束縛する。"
      },
      {
        "id": "resolve",
        "label": "正しい文脈とDAGを解決",
        "focus": [
          "tenant-binding",
          "canonical-context",
          "knowledge-candidate",
          "dag-selection"
        ],
        "note": "Graph・Task・Decision・文書・SoRをprovenance付きで解決し、raw signalはcandidateのまま扱う。"
      },
      {
        "id": "decide",
        "label": "反証と権限判断",
        "focus": [
          "dag-selection",
          "judgment-resolver",
          "authority-gate"
        ],
        "note": "適用DAG、必要証拠、反証、stop conditionを評価し、auto／approval／human_action／denyを決める。"
      },
      {
        "id": "learn",
        "label": "実行結果を組織能力へ戻す",
        "focus": [
          "authorized-action",
          "external-readback",
          "receipts",
          "reviewed-learning"
        ],
        "note": "外部readbackと予測差をReceiptへ固定し、レビュー済み学習だけをGraph・practice・policy・DAGへ昇格する。"
      }
    ]
  },
