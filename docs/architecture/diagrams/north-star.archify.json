  "cards": [
    {
      "dot": "cyan",
      "title": "Brainbaseの製品中心",
      "items": [
        "一つの巨大DAGではなく、会社横断のContext・Judgment・Learning基盤",
        "Domain Judgment Packを選択・接続・統治し、共通scope・authority・receiptを強制する",
        "会社の知識だけでなく『どう判断し、なぜ止まり、結果からどう改善したか』を資産化する"
      ]
    },
    {
      "dot": "emerald",
      "title": "役割分担",
      "items": [
        "人間は主語・目的・優先順位・守る境界を定める",
        "AIは選択肢探索・最強反証・承認済み範囲の実行・結果回収を担う",
        "Domain製品は業務意味、SoRは最終事実、Brainbaseは共通判断統治を担う"
      ]
    },
    {
      "dot": "rose",
      "title": "非目標",
      "items": [
        "Brainbaseを万能Workflow Builder、Secret Vault、GitHub／CRM／会計台帳の代替にしない",
        "raw AI output、chain-of-thought、個人原文、すべてのPRコメントを組織知識へ自動昇格しない",
        "AgentやManaに自己権限付与、cross-tenant fallback、証跡なしの外部作用を許さない"
      ]
    }
  ]
