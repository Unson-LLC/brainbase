      "id": "D-001",
      "status": "fixed",
      "decision": "Canonical snake_case TenantContextEnvelope; RFC 8785 without integrity; detached JWS EdDSA/Ed25519; TTL <= 300 seconds; skew <= 30 seconds; current and retiring public keys."
    },
    {
      "id": "D-002",
      "status": "fixed",
      "decision": "New shared IDs use lowercase prefix plus uppercase Crockford ULID; provider and existing Brainbase IDs remain opaque; Brainbase adds op_<ULID>."
    },
    {
      "id": "D-003",
      "status": "fixed",
      "decision": "Ordered revision invalidation events plus authoritative expected-revision reads immediately before credential lease, Brainbase write, and Slack delivery; cache <= 30 seconds."
    },
    {
      "id": "D-004",
      "status": "fixed",
      "decision": "Protocol mana-brainbase-tenant-context current 1.0 range >=1.0 <2.0; highest mutual minor; no downgrade; deprecation notice >= 90 days."
    },
    {
      "id": "D-005",
      "status": "fixed",
      "decision": "Brainbase solely owns credentials and refresh; runtime uses opaque credential_ref and operation/audience-bound single-use lease <= 60 seconds; OAuth refresh uses CAS."
    },
    {
      "id": "D-006",
      "status": "fixed",
      "decision": "Brainbase owns quota, canonical UsageEvent, OperationReceipt, and business-effect ledger; fixed length-prefixed idempotency formula; terminal claims retained >= 30 days."
    },
    {
      "id": "D-007",
      "status": "fixed",
      "decision": "collection_state collected|partial|not_collected is independent from outcome succeeded|failed|cancelled|timed_out; collected empty is NO_DATA with observed_units=0."
    },
    {
      "id": "D-008",
      "status": "fixed",
      "decision": "Brainbase has no Container execution implementation; consume sanitization status only as optional Receipt evidence."
    },
    {
      "id": "D-009",
      "status": "fixed",
      "decision": "Wire profile customer_managed_oss; only advertised optional capabilities can be non_applicable with reason; common controls never are."
    }
