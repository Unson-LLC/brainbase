# Brainbase Environment Variables
# Copy this file to .env and set the correct values

# Workspace root directory (parent of projects/)
BRAINBASE_ROOT=/path/to/workspace

# Projects root directory (where all projects are located)
PROJECTS_ROOT=/path/to/workspace/projects

# Server port (optional, defaults to 3000)
# PORT=3000

# Slack OAuth (SSOT Auth Gate)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=
# SLACK_AUTH_MODE=oauth
# SLACK_AUTH_SCOPES=
# SLACK_AUTH_USER_SCOPES=chat:write,files:write
# SLACK_AUTH_AUTHORIZE_URL=
# SLACK_AUTH_TOKEN_URL=
# SLACK_AUTH_USERINFO_URL=

# JWT secret for auth
# BRAINBASE_JWT_SECRET=
# Separate secret for bbsvc_ service tokens. Rotate independently from user JWTs.
# BRAINBASE_SERVICE_TOKEN_SECRET=
# BRAINBASE_SERVICE_TOKEN_TTL_SECONDS=31536000

# Public URL for brainbase (used in Device Code Flow verification_uri)
# BRAINBASE_PUBLIC_URL=https://bb.unson.jp

# API URL for mcp-setup (defaults to https://bb.unson.jp)
# For local development, set to http://localhost:31013
# BRAINBASE_API_URL=https://bb.unson.jp

# Judgment Resolver host binding (required by both API and MCP runtimes)
# Generate a high-entropy secret and provision the same value through Infisical.
# BRAINBASE_JUDGMENT_BINDING_SECRET=
# BRAINBASE_JUDGMENT_ADAPTER_ID=brainbase-mcp
# BRAINBASE_JUDGMENT_ADAPTER_VERSION=1
# BRAINBASE_JUDGMENT_BINDING_MAX_AGE_MS=300000
# BRAINBASE_JUDGMENT_BINDING_MAX_FUTURE_SKEW_MS=30000

# Path to ttyd executable (optional, defaults to 'ttyd' in PATH)
# Windows example: TTYD_PATH=C:/Users/YourName/bin/ttyd.exe
# TTYD_PATH=ttyd

# Path to bash executable (optional, defaults to 'bash' in PATH)
# Windows example: BASH_PATH=C:/Program Files/Git/usr/bin/bash.exe
# BASH_PATH=bash

# Info SSOT (Postgres) connection string
# INFO_SSOT_DATABASE_URL=postgres://user:password@localhost:5432/brainbase_ssot

# Canonical tenant runtime producer (disabled by default).
# The runtime contract is served on a dedicated internal port, separate from the public Brainbase API.
# Provision tokens, signing keys, and provider credentials through Infisical; never commit their values.
# BRAINBASE_TENANT_RUNTIME_ENABLED=1
# BRAINBASE_TENANT_RUNTIME_HOST=127.0.0.1
# BRAINBASE_TENANT_RUNTIME_PORT=31016
# BRAINBASE_TENANT_RUNTIME_SERVICE_TOKEN=
# BRAINBASE_TENANT_RUNTIME_AUDIENCE=mana-runtime
# BRAINBASE_TENANT_RUNTIME_DEPLOYMENT_ID=
# BRAINBASE_TENANT_RUNTIME_DEPLOYMENT_PROFILE=shared_cloud
# BRAINBASE_TENANT_CONTEXT_SIGNING_KEY_ID=
# BRAINBASE_TENANT_CONTEXT_SIGNING_KEY_JWK=
# BRAINBASE_TENANT_CREDENTIAL_ENV_REFS_JSON={"opaque-credential-ref":"PROVIDER_CREDENTIAL_ENV_NAME"}
# Provider secrets remain server-side. Each operation fixes method/path/query/body/response behavior.
# BRAINBASE_TENANT_PROVIDER_FORWARDERS_JSON={"provider-audience":{"provider":"provider-name","base_url":"https://provider.example","operations":{"operation.create":{"method":"POST","path":"/v1/operation","body_encoding":"json","response_encoding":"json","credential_placement":"bearer"}}}}
# Set only for a private service network that cannot use loopback.
# BRAINBASE_TENANT_RUNTIME_ALLOW_NON_LOOPBACK=0

# SNS review-pack importer. The service token must authenticate both the internal resolver and SNS API.
# BRAINBASE_TENANT_RUNTIME_URL=http://127.0.0.1:31016
# BRAINBASE_SNS_SERVICE_TOKEN=
# BRAINBASE_SNS_TENANT_ID=
# BRAINBASE_SNS_TENANT_REVISION=
# BRAINBASE_SNS_CONNECTION_ID=
# BRAINBASE_SNS_CONNECTION_REVISION=
# BRAINBASE_SNS_SERVICE_PRINCIPAL_ID=
# BRAINBASE_SNS_CHANNEL_ID=
# BRAINBASE_SNS_RESOURCE_OBJECT_TYPE=project
# BRAINBASE_SNS_RESOURCE_ID=

# Google Calendar integration via gogcli (optional)
# Comma-separated calendar IDs. Defaults to primary when omitted.
# BRAINBASE_GOOGLE_CALENDAR_IDS=primary
