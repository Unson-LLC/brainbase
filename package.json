  "files": [
    "dist",
    "contracts",
    "ui",
    "docs/architecture/judgment-dag-core.md",
    "docs/management/judgment-dag-milestones.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude tests/npm-prepublication-evidence.integration.test.ts",
    "test:integration": "vitest run tests/mcp-contract.test.ts tests/ontology-cli.test.ts tests/npm-release-validation.integration.test.ts tests/npm-consumer-smoke.integration.test.ts",
    "test:consumer-smoke": "vitest run tests/npm-consumer-smoke.integration.test.ts",
    "test:integration:release-evidence": "vitest run tests/npm-release-validation.integration.test.ts tests/npm-prepublication-evidence.integration.test.ts",
    "test:e2e": "vitest run tests/e2e/brainbase-mcp-only-acceptance.spec.ts tests/e2e/story-brainbase-portable-ontology-kernel-acceptance.spec.ts",
    "docs:dev": "vitepress dev docs",
    "docs:sync": "node scripts/sync-public-message.mjs --write",
    "docs:check": "node scripts/check-public-docs.mjs && node scripts/check-organization-teaser.mjs",
    "docs:build": "vitepress build docs",
    "docs:smoke": "node scripts/check-built-docs.mjs && node scripts/check-built-organization-teaser.mjs",
    "docs:verify-public": "node scripts/verify-public-site.mjs && node scripts/verify-organization-teaser.mjs",
    "docs:promotion:plan": "node scripts/promote-public-message.mjs --plan",
    "docs:promotion:apply": "node scripts/promote-public-message.mjs --apply",
    "docs:preview": "vitepress preview docs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "doctor": "node dist/cli.js doctor",
    "onboard:init": "node dist/cli.js onboard:init",
    "onboard:start": "node dist/cli.js onboard:start",
    "onboard:seed": "node dist/cli.js onboard:seed",
    "onboard:demo": "node dist/cli.js onboard:demo",
    "onboard:install": "node dist/cli.js onboard:install",
    "contracts:generate": "node scripts/generate-judgment-dag-contract-artifacts.mjs",
    "release:plan": "node scripts/npm-release.mjs plan",
    "release:validate": "node scripts/npm-release.mjs validate",
    "release:publish": "node scripts/npm-release.mjs publish",
    "release:verify": "node scripts/npm-release.mjs verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.56"
  },
  "overrides": {
    "ip-address": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
