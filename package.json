{
  "name": "brainbase-ui",
  "version": "0.4.29",
  "private": false,
  "type": "module",
  "description": "AI-first project management console for developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unson-LLC/brainbase.git"
  },
  "license": "MIT",
  "author": "Unson LLC",
  "keywords": [
    "project-management",
    "ai-pm",
    "developer-tools",
    "task-management",
    "event-driven",
    "tdd",
    "claude-code"
  ],
  "bugs": {
    "url": "https://github.com/Unson-LLC/brainbase/issues"
  },
  "homepage": "https://github.com/Unson-LLC/brainbase#readme",
  "bin": {
    "brainbase": "./cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prestart": "bash scripts/check-worktree.sh",
    "predev": "bash scripts/check-worktree.sh",
    "dev": "BRAINBASE_ALLOW_DIRECT_SERVER=1 node --watch-path=server --watch-path=lib --watch-path=public --watch-path=server.js --watch-path=package.json --watch-preserve-output server.js",
    "start": "node start.js",
    "auth-setup": "node scripts/auth-setup.mjs",
    "meeting-source:mcp-login": "node scripts/meeting-source-mcp-oauth-login.mjs",
    "test:server": "INTERNAL_API_SECRET=${BRAINBASE_E2E_INTERNAL_API_SECRET:-brainbase-e2e-internal-api-secret} BRAINBASE_TEST_MODE=true BRAINBASE_VAR_DIR=${BRAINBASE_E2E_VAR_DIR:-var/e2e-runtime} BRAINBASE_STATE_PATH=${BRAINBASE_E2E_VAR_DIR:-var/e2e-runtime}/state.json BRAINBASE_ALLOW_DIRECT_SERVER=1 node server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:tenant-production-provisioning": "vitest run --maxWorkers=1 tests/server/bootstrap/tenant-runtime-internal-server.test.js tests/server/bootstrap/slack-installation-control-plane-auth-order.test.js tests/server/bootstrap/slack-installation-control-plane.test.js tests/server/cloudflare/tenant-runtime-bridge.test.js tests/server/cloudflare/slack-installation-control-plane-bridge.test.js tests/server/routes/tenant-runtime-bootstrap.test.js tests/server/routes/tenant-runtime-contract.test.js tests/server/routes/slack-installation-control-plane.test.js tests/server/scripts/multitenant-platform-schema-migration.test.js tests/server/scripts/provision-tenant.test.js tests/server/scripts/tenant-production-provisioning-migration.integration.test.js tests/server/scripts/tenant-production-provisioning-migration.test.js tests/server/services/multitenant",
    "test:conformance:mana-brainbase": "vitest run --config vitest.conformance.config.js",
    "test:knowledge-resolution": "vitest run tests/unit/knowledge-resolution-service.test.js tests/integration/knowledge-resolution-routes.test.js tests/server/bootstrap/knowledge-resolution-registration.test.js && npm --prefix mcp/brainbase test",
    "test:judgment-resolution": "vitest run tests/unit/codex-owner-visible-readback.test.js tests/unit/judgment-resolver-host-value-proof.test.js tests/unit/judgment-value-proof-adapter.test.js tests/unit/judgment-autonomy.test.js tests/unit/judgment-resolution-service.test.js tests/unit/judgment-resolution-publication.test.js tests/unit/judgment-resolver-host.test.js tests/unit/codex-judgment-hook-readiness.test.js tests/unit/preflight-judgment-binding.test.js tests/unit/knowledge-resolution-service.test.js tests/integration/judgment-resolution-routes.test.js tests/integration/judgment-managed-turn-e2e.test.js tests/integration/judgment-launcher-process.test.js tests/integration/judgment-resolver-host-entrypoint.test.js tests/integration/j0-organization-pinned-artifact-consumer.test.js tests/integration/knowledge-resolution-routes.test.js tests/server/bootstrap/judgment-resolution-registration.test.js tests/server/bootstrap/knowledge-resolution-registration.test.js && npm run typecheck && npm --prefix mcp/brainbase run typecheck && npm --prefix mcp/brainbase test",
    "check:judgment-hook-readiness": "node scripts/check-codex-judgment-hook-readiness.mjs",
    "test:integration:ontology": "vitest run tests/server/controllers/ontology-controller.test.js tests/server/routes/info-ssot-context.test.js tests/server/services/ontology-api.test.js tests/server/services/ontology-mcp-projection.test.js tests/server/scripts/ontology-release-verify.test.js tests/server/services/ontology-postgres-concurrency.test.js",
    "test:integration:graph-maintenance": "vitest run tests/server/services/graph-maintenance-postgres.integration.test.js",
    "test:integration:outcome-case": "bash scripts/verify-outcome-case-postgres-rls-integration.sh",
    "test:integration:onboarding-rls": "vitest run tests/integration/onboarding-postgres-rls.integration.test.js",
    "test:integration:project-provisioning:control-plane": "node --import tsx --test mcp/brainbase/tests/tools/control-plane-tools.test.ts",
    "test:integration:project-provisioning": "bash scripts/verify-project-provisioning-postgres-integration.sh && vitest run tests/integration/project-provisioning-full-flow.test.js && npm run test:integration:project-provisioning:control-plane",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p public/jsconfig.json",
    "test:mobile": "playwright test --config=playwright-lambdatest.config.js tests/e2e/mobile-keyboard-scroll.spec.js",
    "test:mobile:iphone": "playwright test --config=playwright-lambdatest.config.js tests/e2e/mobile-keyboard-scroll.spec.js --project='iPhone 13 Pro - Emulated'",
    "test:mobile:android": "playwright test --config=playwright-lambdatest.config.js tests/e2e/mobile-keyboard-scroll.spec.js --project='Pixel 7 - Emulated'",
    "test:e2e": "playwright test",
    "test:e2e:ontology": "VIBEPRO_EVIDENCE_ID=story-brainbase-ontology-kernel playwright test tests/e2e/story-brainbase-ontology-kernel-contract.spec.ts --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "test:admin-personal-kg-smoke": "node scripts/admin-personal-kg-smoke.mjs",
    "test:personal-kg:production-smoke": "node scripts/personal-knowledge-promotion-production-smoke.mjs",
    "personal-kg:issue-production-smoke-fixture": "node scripts/issue-personal-knowledge-promotion-smoke-fixture.mjs",
    "test:active-indicator": "vitest run tests/server/session-activity-state-machine-contract.test.js tests/server/session-manager.test.js tests/unit/session-activity-state.test.js tests/unit/session-indicators-ws.test.js tests/ui/views/session-view.test.js",
    "vibepro:graph-ssot": "node scripts/vibepro-graph-ssot-check.mjs",
    "ontology:publish": "node scripts/ontology-release-publish.js",
    "ontology:verify": "node scripts/ontology-release-verify.js",
    "ontology:inventory": "node scripts/ontology-writer-inventory.js",
    "ontology:remediate:production:1.0.0": "node scripts/ontology-remediate-production-1.0.0.js",
    "ontology:authority:production:1.0.0": "node scripts/ontology-establish-publication-authority-1.0.0.js",
    "vibepro:component-style": "node scripts/vibepro-component-style-check.mjs",
    "migrate:canonical-task-operations": "node scripts/migrate-canonical-task-operations.js",
    "migrate:canonical-task-columns": "node scripts/migrate-canonical-task-columns.js",
    "backfill:canonical-task-idempotency-keys": "node scripts/backfill-canonical-task-idempotency-keys.js",
    "migrate:canonical-task-postgres": "node scripts/migrate-canonical-task-postgres-store.js",
    "migrate:canonical-task-postgres-workflow": "node scripts/run-canonical-task-postgres-migration-workflow.js",
    "migrate:canonical-task-search-indexes": "node scripts/run-canonical-task-search-index-workflow.js",
    "migrate:multitenant-platform-schema": "node scripts/migrate-multitenant-platform-schema.js",
    "migrate:tenant-production-provisioning": "node scripts/migrate-tenant-production-provisioning.js",
    "provision:tenant": "node scripts/provision-tenant.js",
    "provision:tenant-project-access": "node scripts/provision-tenant-project-access.js",
    "canonical-task:readiness": "node scripts/set-canonical-task-readiness.js",
    "canonical-task:recover-writer": "node scripts/recover-canonical-task-writer.js",
    "canonical-task:check-postgres-concurrency": "node scripts/check-canonical-task-postgres-concurrency.js",
    "preflight:canonical-task-cutover": "node scripts/preflight-canonical-task-cutover.js",
    "capture:canonical-task-cutover": "node scripts/capture-canonical-task-cutover-evidence.js",
    "canonical-task:seed-live-fixture": "node scripts/seed-canonical-task-live-approval-fixture.js",
    "ssot:inventory:local": "node scripts/local-data-server-ssot-inventory.js",
    "ssot:upsert:local": "node scripts/local-data-server-ssot-upsert.js",
    "migrate:m5a": "node scripts/migrate-m5a-production-schema.js",
    "seed:personal-kg:baao-minutes": "node scripts/seed-personal-kg-baao-minutes.js",
    "seed:personal-kg:cross-project-minutes": "node scripts/seed-personal-kg-cross-project-minutes.js",
    "oyasumi:meeting-personal-kg": "node scripts/oyasumi-meeting-personal-kg.js",
    "oyasumi:meeting-personal-kg:all": "node scripts/oyasumi-meeting-personal-kg.js --all-repos",
    "oyasumi:conversation-personal-kg": "node scripts/oyasumi-conversation-personal-kg-v2.js",
    "oyasumi:conversation-personal-kg:backlog": "node scripts/oyasumi-conversation-personal-kg-backlog.js",
    "personal-kg:review-projection": "node scripts/personal-kg-review-projection.js",
    "lint": "npx eslint public/**/*.js server/**/*.js",
    "lint:fix": "npx eslint public/**/*.js server/**/*.js --fix",
    "setup": "bash scripts/setup.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1022.0",
    "@aws-sdk/client-dynamodb": "^3.978.0",
    "@aws-sdk/credential-providers": "^3.978.0",
    "@aws-sdk/lib-dynamodb": "^3.978.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@octokit/rest": "^22.0.1",
    "@unson/brainbase-mcp": "github:Unson-LLC/brainbase#d51550260407bff7782c1a621fa13b12ce9fbfa6",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "front-matter": "^4.0.2",
    "http-proxy-middleware": "^3.0.5",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.2",
    "marked": "^17.0.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "open": "^11.0.0",
    "pg": "^8.18.0",
    "ulid": "^2.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.14.13",
    "@assistant-ui/react-markdown": "^0.14.1",
    "@assistant-ui/react-ui": "^0.2.1",
    "@playwright/test": "^1.48.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@xterm/headless": "^5.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.16",
    "wrangler": "4.124.0"
  }
}
