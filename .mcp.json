{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "brainbase": {
      "type": "http",
      "url": "http://127.0.0.1:39002/mcp"
    },
    "nocodb": {
      "type": "http",
      "url": "http://127.0.0.1:39003/mcp"
    },
    "jibble": {
      "type": "http",
      "url": "http://127.0.0.1:39001/mcp"
    },
    "loki": {
      "command": "/Volumes/UNSON-DRIVE/monitoring/tools/loki-mcp/server",
      "env": {
        "LOKI_URL": "http://localhost:3100",
        "PORT": "19100"
      }
    },
    "slack-unson": {
      "type": "http",
      "url": "http://127.0.0.1:13082/mcp"
    },
    "slack-salestailor": {
      "type": "http",
      "url": "http://127.0.0.1:13081/mcp"
    },
    "slack-techknight": {
      "type": "http",
      "url": "http://127.0.0.1:13083/mcp"
    }
  }
}
