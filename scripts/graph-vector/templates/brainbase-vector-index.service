[Unit]
Description=Brainbase changed Graph entity vector index
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/brainbase
EnvironmentFile=/home/ubuntu/brainbase/.env
EnvironmentFile=/home/ubuntu/brainbase/.env.infisical
EnvironmentFile=/etc/brainbase/embedding.env
ExecStart=/usr/bin/node scripts/graph-vector-index.mjs
TimeoutStartSec=90
MemoryMax=192M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
