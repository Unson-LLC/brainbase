<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brainbase.sns-feedback-metrics-poller</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>source /Users/ksato/.brainbase/runtime-env/brainbase-production.env &amp;&amp; cd /Users/ksato/workspace/repos/brainbase &amp;&amp; npm run sns:poll-metrics -- --date "$(date +%F)" --json</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAINBASE_TEST_MODE</key>
    <string>false</string>
    <key>SNS_METRICS_POLLING_ENABLED</key>
    <string>false</string>
  </dict>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/ksato/workspace/repos/brainbase/var/logs/sns-feedback-metrics-poller.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/ksato/workspace/repos/brainbase/var/logs/sns-feedback-metrics-poller.err.log</string>
</dict>
</plist>
