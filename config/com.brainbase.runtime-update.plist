<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.brainbase.runtime-update</string>
  <key>ProgramArguments</key><array><string>__HOME__/.local/brainbase/runtime-update.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/brainbase-runtime-update.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/brainbase-runtime-update.error.log</string>
  <key>ThrottleInterval</key><integer>30</integer>
</dict></plist>
