<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brainbase.sns-scheduled-publisher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/ksato/workspace/code/brainbase &amp;&amp; npm run sns:scheduled-publish -- --json</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAINBASE_TEST_MODE</key>
    <string>false</string>
    <key>SNS_AUTO_PUBLISH_ENABLED</key>
    <string>false</string>
    <key>BRAINBASE_TENANT_RUNTIME_ENABLED</key>
    <string>0</string>
  </dict>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/ksato/workspace/code/brainbase/var/logs/sns-scheduled-publisher.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/ksato/workspace/code/brainbase/var/logs/sns-scheduled-publisher.err.log</string>
</dict>
</plist>
